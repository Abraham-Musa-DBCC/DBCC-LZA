{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRequestsFromOwningAccount",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "${ACCOUNT_ID}"
        }
      }
    }
  ]
}
